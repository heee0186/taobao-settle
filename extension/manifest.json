{
  "manifest_version": 3,
  "name": "타오바오 배송 자동 확인",
  "version": "1.0.0",
  "description": "웨일이 켜져 있는 동안 정해진 간격으로 아직 안 받은 타오바오 주문의 배송 기록을 확인해서 정산 사이트에 저장해요.",
  "permissions": ["alarms", "storage", "scripting"],
  "host_permissions": [
    "https://buyertrade.taobao.com/*",
    "https://*.taobao.com/*",
    "https://*.supabase.co/*",
    "https://*.vercel.app/*"
  ],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "타오바오 배송 자동 확인", "default_icon": { "16": "icon16.png", "48": "icon48.png", "128": "icon128.png" } },
  "icons": { "16": "icon16.png", "48": "icon48.png", "128": "icon128.png" }
}
